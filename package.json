{
  "name": "fitflow-ai-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "FITFLOW AI: an interactive SaaS product prototype for fitness coaches (portfolio project, frontend only, sample data).",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
