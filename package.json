    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.29",
    "puppeteer-core": "^23.11.1",
